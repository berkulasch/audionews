rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Haberler - herkes okuyabilir, sadece admin yazabilir
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false; // Cloud Functions üzerinden yazılır
    }

    // Kullanıcı profilleri - sadece kendi profilini okuyup yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Favoriler - sadece kendi favorilerini yönetebilir
    match /userFavorites/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Dinleme geçmişi - sadece kendi geçmişi
    match /listeningHistory/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
